datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  mobile_number BigInt
  created_at DateTime @default(now())
  is_profile_complete Boolean @default(false)
  profile   Profile?
  profile_views ProfileViews[]
}

model Profile {
id          Int     @id @default(autoincrement())
is_first_register Boolean @default(true)
profile_for RelationshipType
name        String
date_of_birth  String // date format
education   String?
location    String? // enum?
gender      Gender 
kulam       String
mother_tongue String? @default("Tamil")
height      String?
raghu_kethu String?
sevvai_dhosam String?
raasi String?
star String?
marital_status  MaritalStatus? 
physical_status PhysicalStatus?
number_of_brothers  Int? @default(0)
number_of_brothers_married  Int? @default(0)
number_of_sisters  Int? @default(0)
number_of_sisters_married  Int? @default(0)
father_occupation String?
mother_occupation String?
employment_type EmploymentType?
employed_in     String?
annual_income   AnnualIncome?
image_1     String?
image_2     String?
image_3     String?
image_4     String?
image_5     String?
contact_name String?
contact_number String?
created_at DateTime @default(now())
user_id     Int     @unique
user        User   @relation(fields: [user_id], references: [id])
profile_views ProfileViews[]
contact_requested_by                Contact[]  @relation("contact_requested_by")
contact_requested_to                Contact[]  @relation("contact_requested_to")
shortlisted_by Shortlist[] @relation("shortlisted_by")
  shortlisted_profiles Shortlist[] @relation("shortlisted_profile")
}

enum Gender {
    Male
    Female
}

enum MaritalStatus {
    Unmarried
    Divorced
    Widow
}

enum RelationshipType {
  Myself
  Son
  Daughter
  Sister
  Brother
  Other
}


enum PhysicalStatus {
  Normal
  PhysicallyChallenged
}

enum EmploymentType {
  Private
  Government
  Business
  SelfEmployed
  NotEmployed
}

enum AnnualIncome {
  Below_1_lakh
  Lakh_1_to_2
  Lakh_2_to_5
  Lakh_5_to_10
  Lakh_10_to_15
  Lakh_15_to_20
  Lakh_20_to_50
  Lakh_50_to_90
  Lakh_90_above
}

model ProfileViews {
id          Int     @id @default(autoincrement())
viewed_at   DateTime @default(now())
profile_id  Int
profile     Profile @relation(fields: [profile_id],references: [id])
user_id     Int
user        User    @relation(fields: [user_id], references: [id])
}

model Contact {
id              Int     @id @default(autoincrement())
requested_at    DateTime @default(now())
requested_by    Int
requested_by_profile         Profile  @relation("contact_requested_by", fields: [requested_by], references: [id])
requested_to    Int
requested_to_profile         Profile  @relation("contact_requested_to", fields: [requested_to], references: [id])
is_accepted     Boolean  @default(false)
is_declined     Boolean  @default(false)
accepted_at     DateTime? //@default(now())
declined_at     DateTime? //@default(now())
// is_shortlisted  Boolean?
// shortlisted_at  DateTime?
  @@unique([requested_by, requested_to])
}

model Shortlist {
  id              Int      @id @default(autoincrement())
  shortlisted_at  DateTime @default(now())
  shortlisted_by  Int
  shortlisted_by_profile Profile @relation("shortlisted_by", fields: [shortlisted_by], references: [id])
  shortlisted_profile Int
  shortlisted_profile_rel Profile @relation("shortlisted_profile", fields: [shortlisted_profile], references: [id])

  @@unique([shortlisted_by, shortlisted_profile])
}
